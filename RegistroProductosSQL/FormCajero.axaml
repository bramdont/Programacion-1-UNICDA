<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RegistroProductosSQL.FormCajero"
        Title="Menú del Cajero"
        Width="360" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Opened="FormCajero_Opened">
  <StackPanel Margin="30" Spacing="12">
    <TextBlock Text="MENÚ DEL CAJERO" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
    <TextBlock x:Name="lblUsuario" Text="Usuario: -" HorizontalAlignment="Center" />
    <TextBlock x:Name="lblTurno" Text="Turno: -" HorizontalAlignment="Center" Margin="0,0,0,10" />
    <Button x:Name="btnFacturar" Content="Facturar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Click="btnFacturar_Click" />
    <Button x:Name="btnCerrarSesion" Content="Cerrar sesión" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Click="btnCerrarSesion_Click" />
  </StackPanel>
</Window>
