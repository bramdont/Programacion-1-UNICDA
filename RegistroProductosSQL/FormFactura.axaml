<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:RegistroProductosSQL.Modelo"
        x:Class="RegistroProductosSQL.FormFactura"
        Title="Nueva Factura"
        Width="900" Height="680"
        WindowStartupLocation="CenterOwner"
        Opened="FormFactura_Opened">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="15" RowSpacing="12">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock x:Name="lblNumero" Text="Factura nueva (el número se asigna al guardar)" FontSize="18" FontWeight="Bold" />
      <TextBlock x:Name="lblCajero" Text="Cajero: -" />
    </StackPanel>

    <StackPanel Grid.Row="1" x:Name="panelEdicion" Spacing="12">
      <Grid ColumnDefinitions="Auto,*,Auto,200" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="Cliente:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="txtCliente" Watermark="Nombre del cliente" />
        <TextBlock Grid.Column="2" Text="Cédula:" VerticalAlignment="Center" />
        <TextBox Grid.Column="3" x:Name="txtCedula" />
      </Grid>
      <Grid ColumnDefinitions="Auto,80,Auto,*,Auto,70,Auto,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="Código:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="txtCodigo" Watermark="opcional" />
        <TextBlock Grid.Column="2" Text="Artículo:" VerticalAlignment="Center" />
        <ComboBox Grid.Column="3" x:Name="cbProducto" HorizontalAlignment="Stretch" PlaceholderText="Seleccione un artículo" />
        <TextBlock Grid.Column="4" Text="Cantidad:" VerticalAlignment="Center" />
        <TextBox Grid.Column="5" x:Name="txtCantidad" Text="1" />
        <Button Grid.Column="6" Content="Agregar" Width="90" Click="btnAgregar_Click" />
        <Button Grid.Column="7" Content="Quitar" Width="90" Click="btnQuitar_Click" />
      </Grid>
    </StackPanel>

    <DataGrid Grid.Row="2" x:Name="dgvLineas" x:DataType="m:LineaFactura"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              GridLinesVisibility="All">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Id" Binding="{Binding IdProducto}" Width="Auto" />
        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" />
        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="Auto" />
        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat=N2}" Width="Auto" />
        <DataGridTextColumn Header="Valor" Binding="{Binding Subtotal, StringFormat=N2}" Width="Auto" />
        <DataGridTextColumn Header="ITBIS" Binding="{Binding Itbis, StringFormat=N2}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="30">
      <StackPanel Grid.Column="0" x:Name="panelPago" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Tipo de factura:" VerticalAlignment="Center" />
          <ComboBox x:Name="cbTipo" Width="140" SelectionChanged="cbTipo_SelectionChanged">
            <ComboBoxItem Content="Contado" />
            <ComboBoxItem Content="Crédito" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Monto pagado:" VerticalAlignment="Center" />
          <TextBox x:Name="txtPagado" Width="140" TextChanged="txtPagado_TextChanged" />
          <TextBlock x:Name="lblDevuelta" Text="Devuelta: 0.00" VerticalAlignment="Center" FontWeight="Bold" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
        <TextBlock x:Name="lblBruto" Text="Total bruto: 0.00" HorizontalAlignment="Right" />
        <TextBlock x:Name="lblItbis" Text="ITBIS: 0.00" HorizontalAlignment="Right" />
        <TextBlock x:Name="lblTotal" Text="TOTAL A PAGAR: 0.00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="btnGuardar" Content="Guardar factura" Width="130" Click="btnGuardar_Click" />
      <Button x:Name="btnImprimir" Content="Abrir PDF (F5)" Width="130" Click="btnImprimir_Click" />
      <Button x:Name="btnNueva" Content="Nueva" Width="90" Click="btnNueva_Click" />
      <Button x:Name="btnCerrar" Content="Cerrar" Width="90" Click="btnCerrar_Click" />
    </StackPanel>
  </Grid>
</Window>
