<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RegistroProductosSQL.FormAdmin"
        Title="Menú del Administrador"
        Width="360" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Opened="FormAdmin_Opened">
  <StackPanel Margin="30" Spacing="12">
    <TextBlock Text="MENÚ DEL ADMINISTRADOR" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
    <TextBlock x:Name="lblUsuario" Text="Usuario: -" HorizontalAlignment="Center" Margin="0,0,0,10" />
    <Button x:Name="btnProductos" Content="Productos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Click="btnProductos_Click" />
    <Button x:Name="btnCajeros" Content="Cajeros y turnos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Click="btnCajeros_Click" />
    <Button x:Name="btnReportes" Content="Reportes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Click="btnReportes_Click" />
    <Button x:Name="btnCerrarSesion" Content="Cerrar sesión" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Click="btnCerrarSesion_Click" />
  </StackPanel>
</Window>
